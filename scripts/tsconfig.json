// The Node half. These files never reach a browser, so they are real TypeScript, stripped by Node at run time rather
// than compiled — which is why nothing here emits either.
{
  "compilerOptions": {
    // `ArrayBuffer`'s `transfer` from ES2024, which Node has, for the battle stream's frames to be decoded into again.
    "lib": ["ES2023", "ES2024.ArrayBuffer"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",

    "noEmit": true,

    // Beside the other two projects' caches, which is what `tsconfig.json` already says of its own: one `pnpm clean`
    // clears everything this repository writes. Unset, this is the one of the three whose default lands in the source
    // tree — `scripts/tsconfig.tsbuildinfo`, a cache among the files it is a cache of.
    "tsBuildInfoFile": "../.types/scripts.tsbuildinfo",

    // `tsc -b` in `build:types` builds both projects from one command, and build mode requires this of each of them.
    "composite": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,

    // Node strips the types and runs what is left, so anything it cannot erase in place — an `enum`, a `namespace`, a
    // parameter property — would compile here and fail at run time. This rejects all three at check time instead.
    "erasableSyntaxOnly": true,

    // Node's globals, deliberately absent from the browser project next door.
    "types": ["node"],

    // tesseract.js ships one declaration file for both of its builds, naming `HTMLImageElement` and `OffscreenCanvas`
    // among the images it takes — which this project's lib has no DOM to resolve. `src/tools/inventory/ocr-wasm.mts` is
    // checked here as well as in the browser project, and hands it nothing but a PNG's bytes; skipping the check of
    // declaration files is what lets it be read here without lending the whole project the DOM.
    "skipLibCheck": true,

    // A value import from `src/` has to name the `.ts` file, because Node runs these by stripping types in place and
    // resolves the specifier literally — where `tsc` would have resolved `'../src/generated.js'` onto its `.ts` sibling
    // and said nothing, which is a check passing over an `ERR_MODULE_NOT_FOUND`. Permitted here because nothing in this
    // project emits, so no specifier has to survive into an output file. A *type* import is exempt and stays `.js`,
    // since it is erased before Node sees it — and `src/types.d.ts` could not be named any other way.
    "allowImportingTsExtensions": true
  },
  // The entry points here, and everything under `src/` written as an `.mts` file, which is this project's by that name
  // alone: the browser project's `src/**/*.ts` does not match one, so an `.mts` under `src/` belongs to whichever of
  // the two claims it and would otherwise be checked by neither. What is there now is the inventory library — it
  // reaches `node:child_process` for `adb` and the Tesseract CLI, so it needs Node's lib and must not have the DOM's —
  // `src/gpx-source.mts`, which reaches the same for `git ls-files`, the logic three build scripts import so that it
  // can be tested — `src/artifact.mts`, `src/ics.mts` and `src/gpx-checks.mts`, each beside its test —
  // `src/served-types.mts`, the table of what is served that `src/artifact.mts` and `scripts/serve.mts` both read — and
  // the two tests that read a repository file off disk rather than importing one: `src/styles.test.mts` the
  // stylesheets, `src/build.test.mts` the `package.json`. Then the scripts the skills under `.claude/skills/` run,
  // which import the shared files as this project's entry points do, and would otherwise be the one TypeScript nothing
  // checks.
  "include": ["*.mts", "../src/**/*.mts", "../.claude/skills/*/scripts/*.mts"],

  // These scripts import files the shared project owns, and `tsconfig.shared.json`'s `include` is the one place that
  // lists them. Build mode wants every file a project reads listed by the project that reads it, and this used to mean
  // naming each of them in the `include` above and checking them a second time under this lib set. A reference is what
  // it wanted all along: the shared project emits declarations now, so this one reads those rather than the sources —
  // and the files stay environment-agnostic because that project says so, rather than because two lib sets happen to
  // agree about them.

  "references": [{ "path": "../tsconfig.shared.json" }]
}
