// The part in neither half. These files are imported by a browser module and by a `scripts/` file, so they must assume
// neither DOM nor Node — which is what `lib` without `DOM` and an empty `types` say here. Both of the other projects
// reference this one, so each reads these declarations rather than re-checking the sources, and a `Document` or a
// `process` creeping in is an error in this project rather than something only one consumer notices.
{
  "compilerOptions": {
    "lib": ["ES2023"],
    "target": "ES2023",

    "module": "nodenext",
    "moduleResolution": "nodenext",

    // No JavaScript out of here either: a browser reads these only as part of whichever bundle imported them, and
    // `scripts/bundle.mts` inlines them from the sources rather than from an emitted copy.
    "emitDeclarationOnly": true,

    "declarationDir": ".types",
    "rootDir": "src",

    "composite": true,
    "tsBuildInfoFile": ".types/tsconfig.shared.tsbuildinfo",

    "strict": true,
    "noUncheckedIndexedAccess": true,

    // Nothing ambient at all. An empty list is the point rather than an omission: it is what stops an installed
    // `@types` package from handing Node's globals to a file a browser module imports.
    "types": [],

    // Node runs `scripts/` by stripping types in place, and these files are read from there, so anything it cannot
    // erase — an `enum`, a `namespace`, a parameter property — has to be rejected here as well as next door.
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/coin-bag/release.ts",
    "src/countries.ts",
    "src/event-feed.ts",
    "src/generated.ts",
    "src/gpx-dialect.ts",
    "src/livepokemap/filter-format.ts",
    "src/page-table.ts",
    "src/pgsharp/release.ts",
    "src/pokedex/icons.ts",
    "src/pokedex/types.ts",
    "src/pokemon/names.ts",
    "src/recurring-types.ts",
    "src/release.ts",
    "src/types.d.ts"
  ]
}
