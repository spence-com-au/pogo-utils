// The browser half. Pages serves the compiler's output rather than these files, so this is where the build lives.
{
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "target": "ES2023",

    // `nodenext` rather than `bundler` because it is the only setting that makes a missing extension an *error*. A
    // browser resolves `./dom.js` and nothing else, where `bundler` accepts `./dom` and emits it verbatim — a module
    // that type-checks and 404s. Node's algorithm is the one the browser is actually implementing here.
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // `scripts/bundle.mts` writes the JavaScript, one file per page rather than one per module, so there is nothing for
    // the compiler to emit into `dist/` and no `outDir` here at all. Checking is still this project's job; the bundler
    // does no type analysis whatever.
    "emitDeclarationOnly": true,

    // `composite` forces declarations, which nothing serves — out of the published tree rather than into it. `rootDir`
    // is what `.types/` mirrors now that nothing else is emitted, named rather than inferred so that a file added
    // outside `src/` cannot quietly move every declaration a level down.
    "declarationDir": ".types",
    "rootDir": "src",

    // Beside the declarations, so that one `pnpm clean` clears everything this project writes. `build` clears `dist/`
    // alone, the cache being the difference between a 0.14s `tsc -b` and a 7.06s one, which leaves `pnpm clean` the way
    // to drop a declaration `tsc -b` has stopped emitting and never removes itself. The default is derived from
    // `outDir` when there is one, which put the cache at `dist/tsconfig.tsbuildinfo` and deployed it to the live site —
    // the allowlist in `scripts/assemble.mts` cannot catch that, since it governs what is copied in and this is written
    // before it runs.
    "tsBuildInfoFile": ".types/tsconfig.tsbuildinfo",

    // `tsc -b` in `build:types` builds both projects from one command, and build mode requires this of each of them.
    "composite": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,

    // Nothing ambient at all, as in `tsconfig.shared.json`: every type these modules use is either in the lib set above
    // or reached through an import. An unset `types` would pull in every installed @types package instead, which is how
    // Node's globals would reach a browser module — so the empty list is the setting rather than the absence of one.
    // `@types/leaflet` and `@types/tz-lookup` are unaffected, being found through their packages rather than as
    // globals.
    //
    // WebUSB is the one exception, being a browser API `lib.dom` does not carry: the Inventory page drives a phone over
    // it, and Tango's declarations name `USBDevice` and the rest as the globals `@types/w3c-web-usb` declares.
    "types": ["w3c-web-usb"],

    // tesseract.js ships one declaration file for its Node and browser builds alike, which names Node's `Buffer` among
    // the images it takes, and `scripts/tsconfig.json` meets the same file missing the DOM. Declaration files are
    // skipped rather than lending this project Node's globals to resolve one name nothing here passes.
    "skipLibCheck": true,

    // Pages serves what this emits, and a browser has no loader to erase anything for it, so a construct needing one is
    // not available here at all — the same rejection `scripts/` takes for Node's type stripping, for a different
    // reason.
    "erasableSyntaxOnly": true,

    // The inventory readers are `.mts` files written for Node, which names a module by its own extension, and they name
    // each other that way. They are checked here as well as in `scripts/` — here without Node's globals and there
    // without the DOM's — so a reader reaching for either fails one of the two, and only the two together say it runs
    // on both. Allowed because nothing here emits JavaScript; esbuild resolves an `.mts` specifier as it stands.
    "allowImportingTsExtensions": true,

    // `react-jsx` is the modern transform, which imports what it needs rather than expecting a name in scope, so no
    // module here has to import Preact to write JSX. The source it imports from is the setting that points it at Preact
    // instead of React; `scripts/bundle.mts` is told the same pair, since it is the half that does the transform and
    // the compiler only checks it.
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },

  // Everything in `src/` except what the shared project owns, reached through its declarations instead. Excluding those
  // by name rather than by directory because they sit among the files that import them: they are shared by what reads
  // them, not by where they live.
  //
  // The inventory readers the page runs are named one by one, and the held shell and touchscreen the battle Worker in
  // `src/battle/` drives the phone through, the rest of that directory being Node's: the CLI's transports, the download
  // cache and the tests. So are the battle modules `src/battle/` reaches.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/tools/battle/assets.mts",
    "src/tools/battle/damage.mts",
    "src/tools/battle/energy.mts",
    "src/tools/battle/health.mts",
    "src/tools/battle/layout.mts",
    "src/tools/battle/menus.mts",
    "src/tools/battle/meta.mts",
    "src/tools/battle/minigame.mts",
    "src/tools/battle/options.mts",
    "src/tools/battle/party.mts",
    "src/tools/battle/phone.mts",
    "src/tools/battle/pictures.mts",
    "src/tools/battle/play.mts",
    "src/tools/battle/read.mts",
    "src/tools/battle/recognise.mts",
    "src/tools/battle/record-command.mts",
    "src/tools/battle/reporter.mts",
    "src/tools/battle/run.mts",
    "src/tools/battle/screen.mts",
    "src/tools/battle/selection.mts",
    "src/tools/battle/strategy.mts",
    "src/tools/battle/typing.mts",
    "src/tools/inventory/adb.mts",
    "src/tools/inventory/artwork.mts",
    "src/tools/inventory/badges.mts",
    "src/tools/inventory/config.mts",
    "src/tools/inventory/demo.mts",
    "src/tools/inventory/detail.mts",
    "src/tools/inventory/game-master.mts",
    "src/tools/inventory/held-shell.mts",
    "src/tools/inventory/identify.mts",
    "src/tools/inventory/moves.mts",
    "src/tools/inventory/ocr-wasm.mts",
    "src/tools/inventory/ocr.mts",
    "src/tools/inventory/overlay.mts",
    "src/tools/inventory/png.mts",
    "src/tools/inventory/progress.mts",
    "src/tools/inventory/report.mts",
    "src/tools/inventory/stitch.mts",
    "src/tools/inventory/storage.mts",
    "src/tools/inventory/touchscreen.mts"
  ],
  "exclude": [
    "src/coin-bag/release.ts",
    "src/countries.ts",
    "src/event-feed.ts",
    "src/generated.ts",
    "src/gpx-dialect.ts",
    "src/livepokemap/filter-format.ts",
    "src/page-table.ts",
    "src/pgsharp/release.ts",
    "src/pokedex/icons.ts",
    "src/pokemon/names.ts",
    "src/recurring-types.ts",
    "src/release.ts",
    "src/types.d.ts"
  ],

  "references": [{ "path": "tsconfig.shared.json" }]
}
