<?xml version="1.0" encoding="UTF-8"?>
<gpx xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:pgr="https://spence.com.au/pogo-utils/gpx/1"
     version="1.1"
     creator="https://github.com/spence-com-au/pogo-utils">
  <wpt lat="25.026700" lon="121.535000">
    <name>Daan Forest Park</name>
    <extensions>
      <pgr:city>Taipei</pgr:city>
      <pgr:country>Taiwan</pgr:country>
    </extensions>
  </wpt>

  <wpt lat="22.620335" lon="120.312038">
    <name>Kaohsiung City</name>
    <extensions>
      <pgr:country>Taiwan</pgr:country>
      <pgr:event temporary="true">pokemon-go-tour-alola-kaohsiung-2027</pgr:event>
    </extensions>
  </wpt>

  <wpt lat="25.033612" lon="121.553963">
    <name>Taipei City</name>
    <extensions>
      <pgr:country>Taiwan</pgr:country>
    </extensions>
  </wpt>
</gpx>
